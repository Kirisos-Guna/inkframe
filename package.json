{
  "name": "inkframe",
  "version": "1.0.1",
  "description": "AI explainer videos from a voiceover, made by Claude Code on your own computer",
  "main": "out/main/index.js",
  "author": "m.gunamurugan2004",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "app.inkframe.desktop",
    "productName": "Inkframe",
    "copyright": "Copyright © 2026 Inkframe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "out/**",
      "remotion/**",
      "resources/**",
      "src/shared/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Inkframe-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Inkframe"
    },
    "publish": null
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@remotion/bundler": "^4.0.242",
    "@remotion/cli": "^4.0.242",
    "@remotion/paths": "^4.0.242",
    "@remotion/renderer": "^4.0.242",
    "esbuild": "^0.24.0",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242",
    "zustand": "^4.5.5"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.2.0": true,
    "esbuild@0.24.0": true
  }
}
